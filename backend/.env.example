PORT=3001
DATA_DIR=./data
APPROVED_VERSIONS_FILE=./data/approved-versions.json
# First startup only: creates an admin if no accounts exist. Use >=12 characters.
# Remove both bootstrap values after the account has been created.
BOOTSTRAP_COORDINATOR_EMAIL=
BOOTSTRAP_COORDINATOR_PASSWORD=
# Set true for HTTPS. NODE_ENV=production also enforces Secure cookies.
COOKIE_SECURE=false
# Optional migration-only bearer access. Disabled by default.
ALLOW_LEGACY_API_KEY=false
COORDINATOR_API_KEY=
CORS_ORIGIN=http://localhost:5173

# Gemini is required for PDF ingestion and conversational services.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ElevenLabs is used for speech generation and its Conversational AI agent API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Required to provision the private agent and its Gemini-backed webhook tools.
# Use a random value of at least 32 characters; keep it server-side only.
ELEVENLABS_TOOL_API_KEY=
# Public HTTPS URL where the backend webhook routes can be reached by ElevenLabs.
# A localhost URL is useful only for local route testing; ElevenLabs cannot call it.
PUBLIC_BASE_URL=
# Optional override; provisioned agent IDs are also saved in DATA_DIR/state.json.
ELEVENLABS_AGENT_ID=

# Optional organization-managed email/SMS relay. Disabled by default.
# Only set ENABLED=true after authorizing real delivery and configuring routing.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
