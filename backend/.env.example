PORT=3001
DATA_DIR=./data
APPROVED_VERSIONS_FILE=./data/approved-versions.json
COORDINATOR_API_KEY=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Gemini is required for PDF ingestion and conversational services.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Voice integrations are optional until their routes are used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
