# Optional public API base; Vite embeds it at build time (not container startup).
# Omit to use /api, handled by Vite locally and Nginx in the Docker image.
# VITE_API_URL=https://your-backend.example
# Local Vite proxy override; Docker accepts the same variable via docker run -e.
# API_PROXY_TARGET=http://127.0.0.1:3001
# In Docker, use a backend container hostname or host.docker.internal instead.
# Never put coordinator or provider credentials in VITE_* variables.
