# Cache only successful, fingerprinted Vite assets. HTML and API responses must
# remain fresh; missing chunks must not be cached or replaced with index.html.
map "$status:$request_uri" $response_cache_control {
    default "no-store";
    ~^(200|206|304):/assets/ "public, max-age=31536000, immutable";
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;

    # The backend accepts 20 MiB PDFs plus multipart overhead and 10 MiB audio.
    client_max_body_size 21m;

    add_header Cache-Control $response_cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Use the container's DNS and re-resolve backends after container restarts.
    # Docker bridge networks commonly lack IPv6 even when DNS returns AAAA.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    resolver_timeout 5s;
    set $api_upstream "${API_PROXY_TARGET}";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api {
        return 308 /api/$is_args$args;
    }

    location ^~ /api/ {
        # Match the development proxy: /api/auth/me -> /auth/me; keep queries.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Origin, cookies, revisions and idempotency headers pass through intact.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_hide_header Cache-Control;
    }

    location ^~ /assets/ {
        try_files $uri =404;
    }

    location ~ /\. {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }
}
